# Medical-RAG Environment Configuration
# Copy this file to .env and update with your settings

# ============================================
# OLLAMA CONFIGURATION
# ============================================
# Ollama API Base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM Model
# Options: gemma3:1b, llama3.2, mistral, phi3
DEFAULT_LLM_MODEL=gemma3:1b

# Default Embedding Model
EMBEDDING_MODEL=nomic-embed-text

# ============================================
# VECTOR DATABASE CONFIGURATION
# ============================================
# ChromaDB persist directory (where vector database is stored)
CHROMA_PERSIST_DIRECTORY=chroma_db_doctora_async

# ============================================
# INGESTION SETTINGS
# ============================================
# Data source: RECURSIVE_CRAWL or SITEMAP
DATA_SOURCE=RECURSIVE_CRAWL

# MedlinePlus starting URL
RECURSIVE_START_URL=https://medlineplus.gov/druginformation.html

# Crawling depth (how many link levels to follow)
RECURSIVE_MAX_DEPTH=3

# Maximum pages to crawl (safety limit)
RECURSIVE_MAX_PAGES=500

# Text splitting configuration
SPLITTER_TYPE=CHARACTER
CHUNK_SIZE=1000
CHUNK_OVERLAP=30

# ============================================
# RAG CONFIGURATION
# ============================================
# Default temperature (0.0 - 1.0)
DEFAULT_TEMPERATURE=0.1

# Default number of documents to retrieve (k)
DEFAULT_K=4

# ============================================
# API KEYS (Optional - if using external services)
# ============================================
# Tavily API Key (for web search - optional)
# TAVILY_API_KEY=your_tavily_api_key_here

# Google API Key (for Google embeddings - optional)
# GOOGLE_API_KEY=your_google_api_key_here

# Pinecone API Key (if using Pinecone instead of Chroma - optional)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment_here

# ============================================
# LOGGING AND DEBUGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable verbose logging
VERBOSE=False

# ============================================
# STREAMLIT CONFIGURATION (Optional)
# ============================================
# Streamlit server port
# STREAMLIT_SERVER_PORT=8501

# Streamlit theme
# STREAMLIT_THEME=light

# ============================================
# NOTES
# ============================================
# - This file should be copied to .env and customized
# - Never commit .env file to version control
# - Add .env to your .gitignore file
# - Most settings have defaults and are optional
